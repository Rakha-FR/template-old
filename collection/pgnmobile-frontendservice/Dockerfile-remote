# ---------- STAGE 1: BUILD ----------
FROM registry.pgn.co.id/base/node:lts-slim AS build
WORKDIR /app

# Install dependencies
COPY package.json yarn.lock ./
RUN yarn install --immutable

# Copy source code
COPY . .

# Terima secret multiline dari build arg
ARG REACT_APP_SECRET_PUBLIC_KEY

# Buat .env.local dengan key multiline
# Gunakan printf agar newline tetap terjaga
RUN printf "REACT_APP_SECRET_PUBLIC_KEY=\"%s\"\n" "$REACT_APP_SECRET_PUBLIC_KEY" > .env.local && \
    echo "✅ Injected REACT_APP_SECRET_PUBLIC_KEY to .env.local"

# Copy file .env untuk variabel lain (opsional)
COPY .env .env

# Build React (CRA atau Vite)
RUN yarn build



# ---------- STAGE 2: SERVE ----------
FROM registry.pgn.co.id/base/nginx:alpine
WORKDIR /usr/share/nginx/html

# Copy hasil build ke nginx
COPY --from=build /app/build .

# Tambahkan rule agar route React jalan
RUN sed -i '/index.html/a try_files $uri $uri/ /index.html;' /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
