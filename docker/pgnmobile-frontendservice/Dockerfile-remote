FROM registry.pgn.co.id/base/node:lts-slim AS build
WORKDIR /app

# Install dependencies
COPY package.json yarn.lock ./
RUN yarn install --immutable

# Copy source & build
COPY . .
COPY .env .env
RUN yarn build



FROM registry.pgn.co.id/base/nginx:alpine
RUN addgroup -S www-data || true \
 && adduser -S -G www-data www-data || true
RUN mkdir -p /usr/share/nginx/html/tmp \
    && mkdir -p /usr/share/nginx/html/tmp/client_temp \
    && mkdir -p /usr/share/nginx/html/tmp/proxy_temp \
    && mkdir -p /usr/share/nginx/html/tmp/fastcgi_temp \
    && mkdir -p /usr/share/nginx/html/tmp/uwsgi_temp \
    && mkdir -p /usr/share/nginx/html/tmp/scgi_temp \
    && mkdir -p /usr/share/nginx/html/logs \
    && chown -R www-data:www-data /usr/share/nginx/html
# Copy build React
WORKDIR /usr/share/nginx/html
COPY --from=build /app/build .
RUN sed -i '/index.html/a try_files $uri $uri/ /index.html;' /etc/nginx/conf.d/default.conf
RUN sed -i '/http {/a \
    client_body_temp_path /usr/share/nginx/html/tmp/client_temp;\n\
    proxy_temp_path /usr/share/nginx/html/tmp/proxy_temp;\n\
    fastcgi_temp_path /usr/share/nginx/html/tmp/fastcgi_temp;\n\
    uwsgi_temp_path /usr/share/nginx/html/tmp/uwsgi_temp;\n\
    scgi_temp_path /usr/share/nginx/html/tmp/scgi_temp;\n\
    access_log /usr/share/nginx/html/logs/access.log;\n\
    error_log /usr/share/nginx/html/logs/error.log warn;' /etc/nginx/nginx.conf
RUN sed -i 's/listen\s\+80;/listen 8080;/g' /etc/nginx/conf.d/default.conf
USER www-data
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]