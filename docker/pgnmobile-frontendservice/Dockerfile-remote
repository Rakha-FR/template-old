FROM registry.pgn.co.id/base/node:lts-slim AS build
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --immutable
COPY . .
COPY .env .env
RUN yarn build

FROM registry.pgn.co.id/base/nginx:alpine

RUN sed '/index.html/a try_files $uri $uri/ /index.html;' -i /etc/nginx/conf.d/default.conf

WORKDIR /usr/share/nginx/html
COPY --from=build /app/build .

RUN addgroup -S www-data || true \
 && adduser -S -G www-data www-data || true \
 && mkdir -p /var/cache/nginx /var/run /var/log/nginx \
 && chown -R www-data:www-data /var/cache/nginx /var/run /var/log/nginx

USER www-data

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
